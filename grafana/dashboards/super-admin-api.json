{
  "dashboard": {
    "title": "Super Admin API - Tenant Management & Billing",
    "tags": ["super-admin-api", "tenant-management", "billing", "feature-flags", "audit"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Super Admin API Status",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
        "targets": [{"expr": "up{job=\"super-admin-api\"}", "legendFormat": "Status"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
            "mappings": [{"type": "value", "value": "0", "text": "DOWN"}, {"type": "value", "value": "1", "text": "UP"}],
            "unit": "none", "min": 0, "max": 1
          }
        }
      },
      {
        "id": 2,
        "title": "Request Rate (req/s)",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0},
        "targets": [{"expr": "rate(super_admin_requests_total[5m])", "legendFormat": "RPS"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 100}]},
            "unit": "reqps", "min": 0, "max": 150
          }
        }
      },
      {
        "id": 3,
        "title": "Error Rate (%)",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0},
        "targets": [{"expr": "rate(super_admin_requests_total{status=~\"5..\"}[5m]) / rate(super_admin_requests_total[5m]) * 100", "legendFormat": "Error %"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]},
            "unit": "percent", "min": 0, "max": 10
          }
        }
      },
      {
        "id": 4,
        "title": "Billing Success Rate (%)",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 9, "y": 0},
        "targets": [{"expr": "(1 - (rate(super_admin_billing_failures_total[5m]) / rate(super_admin_billing_attempts_total[5m]))) * 100", "legendFormat": "Success %"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 95}, {"color": "green", "value": 99}]},
            "unit": "percent", "min": 90, "max": 100
          }
        }
      },
      {
        "id": 5,
        "title": "Tenant Provisioning Success (%)",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 12, "y": 0},
        "targets": [{"expr": "(1 - (rate(super_admin_tenant_provision_failures_total[5m]) / rate(super_admin_tenant_provision_attempts_total[5m]))) * 100", "legendFormat": "Success %"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 95}]},
            "unit": "percent", "min": 80, "max": 100
          }
        }
      },
      {
        "id": 6,
        "title": "Audit Queue Depth",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 15, "y": 0},
        "targets": [{"expr": "super_admin_audit_queue_depth", "legendFormat": "Queue"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5000}, {"color": "red", "value": 10000}]},
            "unit": "short", "min": 0, "max": 15000
          }
        }
      },
      {
        "id": 7,
        "title": "CPU Usage (%)",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 18, "y": 0},
        "targets": [{"expr": "rate(process_cpu_seconds_total{job=\"super-admin-api\"}[5m]) * 100", "legendFormat": "CPU"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 85}]},
            "unit": "percent", "min": 0, "max": 100
          }
        }
      },
      {
        "id": 8,
        "title": "Memory Usage (GB)",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 3, "x": 21, "y": 0},
        "targets": [{"expr": "process_resident_memory_bytes{job=\"super-admin-api\"} / 1024 / 1024 / 1024", "legendFormat": "Memory"}],
        "fieldConfig": {
          "defaults": {
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1.5}, {"color": "red", "value": 2.0}]},
            "unit": "gbytes", "min": 0, "max": 4
          }
        }
      },
      {
        "id": 9,
        "title": "Tenant Provisioning Rate (tenants/min)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {"expr": "rate(super_admin_tenant_provision_attempts_total[5m]) * 60", "legendFormat": "Attempts"},
          {"expr": "rate(super_admin_tenant_provision_successes_total[5m]) * 60", "legendFormat": "Successes"},
          {"expr": "rate(super_admin_tenant_provision_failures_total[5m]) * 60", "legendFormat": "Failures"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "mean", "max"]}},
        "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}}
      },
      {
        "id": 10,
        "title": "Billing Transaction Rate (txns/min)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {"expr": "rate(super_admin_billing_attempts_total[5m]) * 60", "legendFormat": "Attempts"},
          {"expr": "rate(super_admin_billing_successes_total[5m]) * 60", "legendFormat": "Successes"},
          {"expr": "rate(super_admin_billing_failures_total[5m]) * 60", "legendFormat": "Failures"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "mean", "max"]}},
        "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2}}}
      },
      {
        "id": 11,
        "title": "Database Query Latency (P50, P95, P99)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {"expr": "histogram_quantile(0.5, rate(super_admin_db_query_duration_seconds_bucket[5m]))", "legendFormat": "P50"},
          {"expr": "histogram_quantile(0.95, rate(super_admin_db_query_duration_seconds_bucket[5m]))", "legendFormat": "P95"},
          {"expr": "histogram_quantile(0.99, rate(super_admin_db_query_duration_seconds_bucket[5m]))", "legendFormat": "P99"}
        ],
        "options": {"legend": {"displayMode": "list", "placement": "bottom", "calcs": ["last", "mean"]}},
        "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}}
      },
      {
        "id": 12,
        "title": "Feature Flag Update Rate (updates/min)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {"expr": "rate(super_admin_feature_flag_update_attempts_total[5m]) * 60", "legendFormat": "Attempts"},
          {"expr": "rate(super_admin_feature_flag_update_successes_total[5m]) * 60", "legendFormat": "Successes"},
          {"expr": "rate(super_admin_feature_flag_update_failures_total[5m]) * 60", "legendFormat": "Failures"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "mean", "max"]}},
        "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2}}}
      },
      {
        "id": 13,
        "title": "Stripe API Error Distribution",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {"expr": "rate(super_admin_stripe_errors_total{error_type=\"rate_limit\"}[5m])", "legendFormat": "Rate Limit"},
          {"expr": "rate(super_admin_stripe_errors_total{error_type=\"api_connection\"}[5m])", "legendFormat": "Connection"},
          {"expr": "rate(super_admin_stripe_errors_total{error_type=\"card_declined\"}[5m])", "legendFormat": "Card Declined"},
          {"expr": "rate(super_admin_stripe_errors_total{error_type=\"invalid_request\"}[5m])", "legendFormat": "Invalid Request"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "mean", "max"]}},
        "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2}}}
      },
      {
        "id": 14,
        "title": "User Management Operations (ops/min)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {"expr": "rate(super_admin_user_create_total[5m]) * 60", "legendFormat": "Create"},
          {"expr": "rate(super_admin_user_update_total[5m]) * 60", "legendFormat": "Update"},
          {"expr": "rate(super_admin_user_delete_total[5m]) * 60", "legendFormat": "Delete"},
          {"expr": "rate(super_admin_user_operation_failures_total[5m]) * 60", "legendFormat": "Failures"}
        ],
        "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["last", "mean", "max"]}},
        "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2}}}
      }
    ]
  }
}
