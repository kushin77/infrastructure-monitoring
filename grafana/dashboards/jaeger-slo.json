{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "id": null,
    "uid": "jaeger-slo",
    "title": "Jaeger SLO Monitoring",
    "tags": ["jaeger", "slo", "sli"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "Trace Collection Success Rate (Target: 99.9%)",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
        "targets": [{
          "expr": "(sum(rate(jaeger_collector_traces_received_total[5m])) - sum(rate(jaeger_collector_spans_dropped_total[5m]))) / sum(rate(jaeger_collector_traces_received_total[5m])) * 100",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 95,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 95, "color": "red"},
                {"value": 99, "color": "yellow"},
                {"value": 99.9, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 2,
        "title": "Query Latency SLO (Target: P95 < 1s)",
        "type": "gauge",
        "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
        "targets": [{
          "expr": "histogram_quantile(0.95, rate(jaeger_query_requests_duration_seconds_bucket[5m]))",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "max": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 1.5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Service Uptime SLO (Target: 99.9%)",
        "type": "gauge",
        "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
        "targets": [{
          "expr": "avg_over_time(up{job=\"jaeger\"}[5m]) * 100",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 95,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 95, "color": "red"},
                {"value": 99, "color": "yellow"},
                {"value": 99.9, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Error Budget Remaining (30-day window)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 4},
        "targets": [{
          "expr": "100 - ((sum(increase(jaeger_collector_spans_dropped_total[30d])) / sum(increase(jaeger_collector_traces_received_total[30d]))) * 100 / 0.1)",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 25, "color": "yellow"},
                {"value": 50, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 5,
        "title": "SLO Burn Rate (last 1 hour)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 6, "w": 12, "h": 4},
        "targets": [{
          "expr": "rate(jaeger_collector_spans_dropped_total[1h]) / rate(jaeger_collector_traces_received_total[1h])",
          "legendFormat": "Burn Rate",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          }
        },
        "alert": {
          "name": "High SLO Burn Rate",
          "conditions": [{"evaluator": {"params": [0.001], "type": "gt"}}]
        }
      },
      {
        "id": 6,
        "title": "Incident Timeline",
        "type": "graph",
        "gridPos": {"x": 0, "y": 10, "w": 24, "h": 6},
        "targets": [{
          "expr": "ALERTS{alertname=~\"Jaeger.*\"}",
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }],
        "options": {
          "showLines": false,
          "showPoints": "always"
        }
      },
      {
        "id": 7,
        "title": "SLO Compliance by Service",
        "type": "table",
        "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
        "targets": [{
          "expr": "sum(rate(jaeger_collector_spans_received_total[5m])) by (service_name)",
          "refId": "A",
          "format": "table",
          "instant": false
        }, {
          "expr": "sum(rate(jaeger_collector_spans_received_total{status=\"error\"}[5m])) by (service_name) / sum(rate(jaeger_collector_spans_received_total[5m])) by (service_name) * 100",
          "refId": "B",
          "format": "table",
          "instant": false
        }, {
          "expr": "histogram_quantile(0.95, sum(rate(jaeger_collector_spans_duration_seconds_bucket[5m])) by (le, service_name))",
          "refId": "C",
          "format": "table",
          "instant": false
        }],
        "transformations": [
          {"id": "merge"},
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "service_name": "Service",
                "Value #A": "Request Rate",
                "Value #B": "Error Rate (%)",
                "Value #C": "P95 Latency (s)"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Error Rate (%)"},
              "properties": [{
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }]
            },
            {
              "matcher": {"id": "byName", "options": "P95 Latency (s)"},
              "properties": [{
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }]
            }
          ]
        }
      }
    ]
  }
}
