{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "id": null,
    "uid": "jaeger-service-performance",
    "title": "Jaeger Service Performance",
    "tags": ["jaeger", "services", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate per Service (last 5 min)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6},
        "targets": [{
          "expr": "sum(rate(jaeger_collector_spans_received_total[5m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }]
      },
      {
        "id": 2,
        "title": "Error Rate per Service (%)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6},
        "targets": [{
          "expr": "sum(rate(jaeger_collector_spans_received_total{status=\"error\"}[5m])) by (service_name) / sum(rate(jaeger_collector_spans_received_total[5m])) by (service_name) * 100",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "P50 Latency per Service",
        "type": "graph",
        "gridPos": {"x": 0, "y": 6, "w": 8, "h": 5},
        "targets": [{
          "expr": "histogram_quantile(0.50, sum(rate(jaeger_collector_spans_duration_seconds_bucket[5m])) by (le, service_name))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 4,
        "title": "P95 Latency per Service",
        "type": "graph",
        "gridPos": {"x": 8, "y": 6, "w": 8, "h": 5},
        "targets": [{
          "expr": "histogram_quantile(0.95, sum(rate(jaeger_collector_spans_duration_seconds_bucket[5m])) by (le, service_name))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "P99 Latency per Service",
        "type": "graph",
        "gridPos": {"x": 16, "y": 6, "w": 8, "h": 5},
        "targets": [{
          "expr": "histogram_quantile(0.99, sum(rate(jaeger_collector_spans_duration_seconds_bucket[5m])) by (le, service_name))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 6,
        "title": "Top 10 Slowest Operations",
        "type": "table",
        "gridPos": {"x": 0, "y": 11, "w": 12, "h": 6},
        "targets": [{
          "expr": "topk(10, histogram_quantile(0.95, sum(rate(jaeger_collector_spans_duration_seconds_bucket[10m])) by (le, operation)))",
          "refId": "A",
          "format": "table",
          "instant": true
        }],
        "transformations": [
          {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"operation": "Operation", "Value": "P95 Latency (s)"}}}
        ]
      },
      {
        "id": 7,
        "title": "Top 10 Error Operations",
        "type": "table",
        "gridPos": {"x": 12, "y": 11, "w": 12, "h": 6},
        "targets": [{
          "expr": "topk(10, sum(rate(jaeger_collector_spans_received_total{status=\"error\"}[10m])) by (operation))",
          "refId": "A",
          "format": "table",
          "instant": true
        }],
        "transformations": [
          {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"operation": "Operation", "Value": "Error Rate"}}}
        ]
      },
      {
        "id": 8,
        "title": "Service Dependency Graph",
        "type": "text",
        "gridPos": {"x": 0, "y": 17, "w": 24, "h": 4},
        "options": {
          "mode": "html",
          "content": "<iframe src=\"http://dev.elevatediq.ai:16686/search?service=elevatediq-gateway-api\" width=\"100%\" height=\"400px\" frameborder=\"0\"></iframe>"
        }
      },
      {
        "id": 9,
        "title": "Throughput by Service (spans/sec)",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 21, "w": 24, "h": 6},
        "targets": [{
          "expr": "sum(rate(jaeger_collector_spans_received_total[5m])) by (service_name)",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      }
    ]
  }
}
