{
  "id": null,
  "uid": "webmaster-selfheal",
  "title": "Webmaster Agent — Self-Heal Overview",
  "timezone": "browser",
  "version": 1,
  "schemaVersion": 38,
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h"
    ]
  },
  "refresh": "30s",
  "tags": [
    "webmaster-agent",
    "self-heal",
    "elevatediq"
  ],
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(webmaster_endpoint_health, endpoint)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(webmaster_endpoint_health, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Endpoints Up",
      "id": 1,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(webmaster_endpoint_health{endpoint=~\"$endpoint\",service=~\"$service\"})",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Endpoints Down",
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(1 - webmaster_endpoint_health{endpoint=~\"$endpoint\",service=~\"$service\"})",
          "legendFormat": "down",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "table",
      "title": "Endpoint Health (Table)",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "webmaster_endpoint_health{endpoint=~\"$endpoint\",service=~\"$service\"}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields"
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": [
              "Time",
              "Value",
              "endpoint",
              "service"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "endpoint": 1,
              "service": 2,
              "Value": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "timeseries",
      "title": "Response Time (avg, seconds)",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (endpoint) (webmaster_endpoint_response_time_seconds{endpoint=~\"$endpoint\",service=~\"$service\"})",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "SSL Cert — Min Days Remaining",
      "id": 5,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "min(webmaster_endpoint_ssl_days_remaining{endpoint=~\"$endpoint\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "barchart",
      "title": "Lighthouse Performance Score",
      "id": 6,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (endpoint) (webmaster_lighthouse_score{category=\"performance\",endpoint=~\"$endpoint\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent(0-100)"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Security Score",
      "id": 7,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 14
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (endpoint) (webmaster_security_score{endpoint=~\"$endpoint\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent(0-100)"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Drift Detected (increase over 24h)",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (type) (increase(webmaster_drift_detected_total{endpoint=~\"$endpoint\"}[24h]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "stat",
      "title": "Analysis Duration (avg over 1h)",
      "id": 9,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 20
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg_over_time(webmaster_analysis_duration_seconds[1h])",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Top Slow Endpoints (last)",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "webmaster_endpoint_response_time_seconds{endpoint=~\"$endpoint\"}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields"
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": [
              "Time",
              "Value",
              "endpoint"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "stat",
      "title": "Auto-Remediation Attempts (1h)",
      "id": 11,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(webmaster_autofix_attempts_total{status=~\"success|failed|blocked\"}[1h])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "Failed Remediations (rate 5m)",
      "id": 12,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 32
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(webmaster_autofix_attempts_total{status=\"failed\"}[5m])",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error Rate (non-2xx)",
      "id": 13,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(webmaster_http_requests_total{status!~\"2..\",endpoint=~\"$endpoint\"}[5m])) / sum(rate(webmaster_http_requests_total{endpoint=~\"$endpoint\"}[5m]))",
          "legendFormat": "error_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Request Volume (rps)",
      "id": 14,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(webmaster_http_requests_total{endpoint=~\"$endpoint\"}[5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Detection → Remediation Latency (p95)",
      "id": 15,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(webmaster_remediation_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "table",
      "title": "Open Drift by Type",
      "id": 16,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (type) (webmaster_drift_open{endpoint=~\"$endpoint\"})",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields"
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": [
              "Time",
              "Value",
              "type"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "stat",
      "title": "PRs Created (24h)",
      "id": 17,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 44
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(webmaster_autopr_created_total[24h]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Active Webmaster Alerts",
      "id": 18,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 18,
        "y": 44
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"webmaster.*\"}",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields"
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": [
              "Time",
              "alertname",
              "severity",
              "endpoint",
              "service",
              "Value"
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ],
  "links": [],
  "annotations": {
    "list": []
  }
}
